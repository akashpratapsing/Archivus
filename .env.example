# GEMINI_API_KEY: Required for Gemini AI API calls (embeddings and generation).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional fallback/alternate LLM provider (llama-3.3-70b-versatile).
GROQ_API_KEY="MY_GROQ_API_KEY"

# LLM_PROVIDER: Active generation provider: "gemini" or "groq" (default: "gemini")
LLM_PROVIDER="gemini"

# Models configuration
GEMINI_GENERATION_MODEL="gemini-3.8-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2-preview"
GROQ_GENERATION_MODEL="llama-3.3-70b-versatile"

# Chroma vector database configuration
CHROMA_HOST="chroma"
CHROMA_PORT="8000"
CHROMA_PERSIST_DIRECTORY="./chroma_db"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

